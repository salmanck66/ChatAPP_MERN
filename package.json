{
  "name": "chatwaer",
  "version": "1.0.0",
  "description": "Real-time one-to-one chat app \u2014 MongoDB, Express, React, Node.js and Socket.IO",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "dev:client": "npm run dev --prefix frontend",
    "build": "npm install && npm install --prefix frontend --include=dev && npm run build --prefix frontend"
  },
  "keywords": [
    "mern",
    "socket.io",
    "chat",
    "react",
    "express",
    "mongodb"
  ],
  "author": "Salmanul Faris C K",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "nodemailer": "^6.9.14",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
