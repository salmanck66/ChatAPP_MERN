# Copy to .env and fill in. Never commit the real .env.

# Required
MONGO_CONNECTION=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chatwaer
JWT_SECRET=replace-with-a-long-random-string

# Optional
PORT=3000
NODE_ENV=development
# Creates the public demo_alex / demo_sam accounts on startup
DEMO_MODE=true
# Public URL used in password-reset emails (defaults to the request's host)
APP_URL=http://localhost:3001
# Only needed if the client runs on a different origin than the server
CLIENT_URL=

# Password reset emails (Gmail + App Password)
EMAIL=
EMAIL_PASSWORD=
